# Motor de dados: duckdb (local) ou bigquery
WAREHOUSE=duckdb
DBT_TARGET=duckdb

# --- DuckDB (local) ---
DUCKDB_PATH=./data/elevato.duckdb

# --- BigQuery (quando migrar) ---
# WAREHOUSE=bigquery
# DBT_TARGET=bigquery
# GCP_PROJECT=meu-projeto
# GCP_KEYFILE=./credenciais/service-account.json
# BQ_DATASET=elevato
# BQ_LOCATION=southamerica-east1
# RAW_SCHEMA=elevato_raw

# --- DWs Postgres (consulta ad-hoc via scripts/consultar_dw.py) ---
# DW_USER=usuario
# DW_PASSWORD=senha
#
# DWELEVATO_HOST=host-do-dwelevato
# DWELEVATO_PORT=5432
# DWELEVATO_DBNAME=dwelevato
#
# DWANALITICO_HOST=host-do-dwanalitico
# DWANALITICO_PORT=5432
# DWANALITICO_DBNAME=dwanalitico
